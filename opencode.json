{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "js/curso.js": "deny",
      "CAMBIOS.md": "deny",
      "docs/PENDIENTES.md": "deny",
      "herramientas/version.mjs": "deny",
      "AGENTS.md": "deny",
      "opencode.json": "deny"
    },
    "bash": {
      "*": "ask",
      "node *": "allow",
      "git diff*": "allow",
      "git status*": "allow",
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git checkout*": "deny",
      "git reset*": "deny",
      "rm *": "deny"
    }
  }
}
